@model Announcement
@{
    ViewData["Title"] = "Yeni Duyuru Ekle";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">Duyurular</a></li>
                <li class="breadcrumb-item active" aria-current="page">Yeni Duyuru</li>
            </ol>
        </nav>

        <div class="card p-5 bg-white border rounded-4 shadow-sm">
            <h3 class="fw-bold text-dark mb-4">
                <i class="fa-solid fa-pen-to-square text-primary me-2"></i> Yeni Duyuru Yayınla
            </h3>

            <form asp-action="Create" method="post">
                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Title" class="form-label fw-bold">Duyuru Başlığı</label>
                    <input asp-for="Title" class="form-control" placeholder="Örn: 2026 Mezunlar Zirvesi" required />
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Category" class="form-label fw-bold">Kategori</label>
                        <select asp-for="Category" class="form-select">
                            <option value="Genel">Genel</option>
                            <option value="Etkinlik">Etkinlik</option>
                            <option value="Kariyer">Kariyer</option>
                            <option value="Akademik">Akademik</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Author" class="form-label fw-bold">Yayınlayan Birim / Kişi</label>
                        <input asp-for="Author" class="form-control" placeholder="Örn: Kariyer Merkezi" />
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Content" class="form-label fw-bold">Duyuru İçeriği</label>
                    <textarea asp-for="Content" rows="6" class="form-control" placeholder="Duyuru detaylarını buraya yazınız..." required></textarea>
                </div>

                <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="fa-solid fa-xmark me-1"></i> İptal
                    </a>
                    <button type="submit" class="btn btn-konekto px-4">
                        <i class="fa-solid fa-paper-plane me-1"></i> Duyuruyu Yayınla
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
