@model Announcement
@{
    ViewData["Title"] = Model.Title;
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">Duyurular</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
            </ol>
        </nav>

        <div class="card p-5 bg-white border rounded-4 shadow-sm">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="badge bg-primary-subtle text-primary fw-bold px-3 py-2 rounded-pill">
                    @Model.Category
                </span>
                <span class="text-muted small">
                    <i class="fa-regular fa-calendar me-1"></i> @Model.CreatedAt.ToString("dd MMMM yyyy, HH:mm")
                </span>
            </div>

            <h2 class="fw-bold text-dark mb-4">@Model.Title</h2>

            <div class="d-flex align-items-center mb-4 pb-3 border-bottom text-muted">
                <i class="fa-solid fa-circle-user fa-2x text-primary me-2"></i>
                <div>
                    <div class="fw-bold text-dark">@Model.Author</div>
                    <small>Yayınlayan Birim</small>
                </div>
            </div>

            <div class="announcement-content text-secondary leading-relaxed mb-5" style="white-space: pre-line; font-size: 1.05rem;">
                @Model.Content
            </div>

            <div class="d-flex justify-content-between align-items-center pt-4 border-top">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="fa-solid fa-arrow-left me-1"></i> Geri Dön
                </a>
                <a asp-action="Delete" asp-route-id="@Model.Id" onclick="return confirm('Bu duyuruyu silmek istediğinize emin misiniz?');" class="btn btn-outline-danger">
                    <i class="fa-solid fa-trash me-1"></i> Duyuruyu Sil
                </a>
            </div>
        </div>
    </div>
</div>

