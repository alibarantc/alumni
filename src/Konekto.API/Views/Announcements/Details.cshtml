@model Announcement
@{
    ViewData["Title"] = Model.Title;

    var badgeClass = Model.Category switch {
        "Etkinlik" => "bg-warning-subtle text-warning",
        "Kariyer" => "bg-success-subtle text-success",
        "Akademik" => "bg-info-subtle text-info",
        _ => "bg-primary-subtle text-primary"
    };
}

<style>
    .announcement-detail-card {
        background: #ffffff;
        border: 1px solid var(--color-border-subtle);
        border-radius: 24px;
        padding: 44px;
        box-shadow: var(--shadow-card);
    }
    .author-banner-box {
        background: #F8FAFC;
        border: 1px solid var(--color-border-subtle);
        border-radius: 16px;
        padding: 16px 20px;
    }
    .author-avatar-sm {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: linear-gradient(135deg, #4F46E5 0%, #7C3AED 100%);
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 1rem;
    }
    .article-body {
        font-size: 1.05rem;
        line-height: 1.8;
        color: var(--color-text-body);
        white-space: pre-line;
    }
</style>

<div class="row justify-content-center">
    <div class="col-lg-9 col-xl-8">
        <!-- Breadcrumb Navigation -->
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb small">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Ana Sayfa</a></li>
                <li class="breadcrumb-item"><a asp-controller="Announcements" asp-action="Index" class="text-decoration-none text-muted">Duyurular</a></li>
                <li class="breadcrumb-item active text-dark fw-semibold" aria-current="page">@Model.Title</li>
            </ol>
        </nav>

        <!-- Main Announcement Card -->
        <div class="announcement-detail-card">
            <!-- Header Badges & Date -->
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                <span class="badge @badgeClass fw-bold px-3 py-2 rounded-pill">
                    <i class="fa-solid fa-tag me-1"></i> @Model.Category
                </span>
                <span class="text-muted small">
                    <i class="fa-regular fa-clock me-1"></i> @Model.CreatedAt.ToString("dd MMMM yyyy, HH:mm")
                </span>
            </div>

            <!-- Title -->
            <h1 class="h2 fw-bold text-dark mb-4" style="line-height: 1.3; letter-spacing: -0.02em;">
                @Model.Title
            </h1>

            <!-- Author Info Box -->
            <div class="author-banner-box d-flex align-items-center justify-content-between mb-4">
                <div class="d-flex align-items-center gap-3">
                    <div class="author-avatar-sm">
                        @(string.IsNullOrWhiteSpace(Model.Author) ? "K" : Model.Author.Substring(0, 1))
                    </div>
                    <div>
                        <div class="fw-bold text-dark d-flex align-items-center gap-2">
                            <span>@Model.Author</span>
                            <i class="fa-solid fa-circle-check text-primary small" title="Doğrulanmış Üniversite Birimi"></i>
                        </div>
                        <small class="text-muted">Resmi Üniversite & Topluluk Birimi</small>
                    </div>
                </div>
                <div class="d-none d-sm-block">
                    <span class="badge bg-white border text-secondary rounded-pill px-3 py-1 small">
                        Duyuru #@Model.Id
                    </span>
                </div>
            </div>

            <!-- Content -->
            <div class="article-body mb-5">
                @Model.Content
            </div>

            <!-- Action Bar -->
            <div class="d-flex flex-wrap justify-content-between align-items-center pt-4 border-top gap-3">
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                    <i class="fa-solid fa-arrow-left me-2"></i> Tüm Duyurulara Dön
                </a>
                <div class="d-flex gap-2">
                    <form asp-action="Delete" asp-route-id="@Model.Id" method="post"
                          onsubmit="return confirm('Bu duyuruyu silmek istediğinize emin misiniz?');">
                        <button type="submit" class="btn btn-outline-danger rounded-pill px-4">
                            <i class="fa-solid fa-trash me-2"></i> Duyuruyu Sil
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
