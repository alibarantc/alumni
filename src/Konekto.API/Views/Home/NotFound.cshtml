@{
    ViewData["Title"] = "404 - Sayfa Bulunamadı";
}

<style>
    .not-found-card {
        background: #ffffff;
        border: 1px solid var(--color-border-subtle);
        border-radius: 24px;
        padding: 48px 36px;
        box-shadow: var(--shadow-elevated);
        position: relative;
        overflow: hidden;
    }
    .not-found-icon-box {
        width: 100px;
        height: 100px;
        border-radius: 50%;
        background: linear-gradient(135deg, #EEF2FF 0%, #E0E7FF 100%);
        color: var(--color-primary);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 2.75rem;
        box-shadow: 0 10px 25px rgba(79, 70, 229, 0.15);
        margin-bottom: 24px;
    }
</style>

<div class="row justify-content-center py-5">
    <div class="col-md-9 col-lg-7 text-center">
        <div class="not-found-card">
            <div class="mb-3">
                <span class="badge bg-danger-subtle text-danger fs-6 fw-bold px-3 py-2 rounded-pill">
                    <i class="fa-solid fa-triangle-exclamation me-1"></i> HTTP 404
                </span>
            </div>

            <div class="not-found-icon-box">
                <i class="fa-solid fa-compass-drafting"></i>
            </div>

            <h1 class="h2 fw-bold text-dark mb-2" style="letter-spacing: -0.02em;">Aradığınız Sayfa Bulunamadı</h1>
            <p class="text-muted small mb-4 px-md-4" style="line-height: 1.6;">
                Ulaşmaya çalıştığınız web sayfası taşınmış, silinmiş veya yanlış bir bağlantı üzerinden talep edilmiş olabilir. Bu talep sistem loglarımıza (logs/error.logs) kaydedilmiştir.
            </p>

            <div class="d-flex flex-wrap justify-content-center gap-2 pt-2">
                <a asp-controller="Home" asp-action="Index" class="btn btn-konekto rounded-pill px-4 py-2">
                    <i class="fa-solid fa-house-chimney me-2"></i> Ana Sayfaya Dön
                </a>
                <a asp-controller="Announcements" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 py-2">
                    <i class="fa-solid fa-bullhorn me-1"></i> Duyurular
                </a>
                <a asp-controller="Alumni" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 py-2">
                    <i class="fa-solid fa-users me-1"></i> Mezun Rehberi
                </a>
            </div>
        </div>
    </div>
</div>
