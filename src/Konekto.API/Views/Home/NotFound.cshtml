@{
    ViewData["Title"] = "404 - Sayfa Bulunamadı";
}

<div class="row justify-content-center py-5">
    <div class="col-md-8 col-lg-6 text-center">
        <div class="card p-5 bg-white border rounded-4 shadow-sm">
            <div class="mb-4">
                <span class="badge bg-danger-subtle text-danger fs-6 fw-bold px-3 py-2 rounded-pill">
                    <i class="fa-solid fa-triangle-exclamation me-1"></i> Hata 404
                </span>
            </div>

            <div class="my-3">
                <i class="fa-solid fa-compass-drafting fa-5x text-primary opacity-75"></i>
            </div>

            <h1 class="display-6 fw-bold text-dark mt-3 mb-2">Aradığınız Sayfa Bulunamadı</h1>
            <p class="text-muted lead fs-6 mb-4">
                Ulaşmaya çalıştığınız web sayfası taşınmış, silinmiş veya adresi yanlış yazılmış olabilir.
            </p>

            <div class="d-flex flex-wrap justify-content-center gap-2 pt-2">
                <a asp-controller="Home" asp-action="Index" class="btn btn-konekto px-4">
                    <i class="fa-solid fa-house me-1"></i> Ana Sayfaya Dön
                </a>
                <a asp-controller="Announcements" asp-action="Index" class="btn btn-outline-secondary px-4">
                    <i class="fa-solid fa-bullhorn me-1"></i> Duyurular
                </a>
                <a asp-controller="Alumni" asp-action="Index" class="btn btn-outline-secondary px-4">
                    <i class="fa-solid fa-users me-1"></i> Mezun Rehberi
                </a>
            </div>
        </div>
    </div>
</div>
