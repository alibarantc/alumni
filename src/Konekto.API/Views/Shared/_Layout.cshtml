<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Konekto Mezun Portalı</title>

    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet">

    <!-- Bootstrap 5.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Font Awesome 6.5 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <style>
        :root {
            --color-primary: #4F46E5;
            --color-primary-hover: #4338CA;
            --color-primary-light: #EEF2FF;
            --color-primary-glow: rgba(79, 70, 229, 0.25);

            --color-accent-blue: #3B82F6;
            --color-accent-purple: #8B5CF6;

            --color-bg-canvas: #F8FAFC;
            --color-bg-surface: #FFFFFF;
            --color-bg-subtle: #F1F5F9;

            --color-border-subtle: #E2E8F0;
            --color-border-hover: #CBD5E1;

            --color-text-heading: #0F172A;
            --color-text-body: #334155;
            --color-text-muted: #64748B;

            --color-success: #10B981;
            --color-success-bg: #ECFDF5;
            --color-warning: #F59E0B;
            --color-warning-bg: #FFFBEB;
            --color-danger: #EF4444;
            --color-danger-bg: #FEF2F2;
            --color-info: #0EA5E9;
            --color-info-bg: #F0F9FF;

            --radius-sm: 8px;
            --radius-md: 12px;
            --radius-lg: 16px;
            --radius-xl: 24px;
            --radius-full: 9999px;

            --shadow-subtle: 0 1px 3px rgba(0, 0, 0, 0.05), 0 1px 2px rgba(0, 0, 0, 0.03);
            --shadow-card: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -2px rgba(0, 0, 0, 0.05);
            --shadow-elevated: 0 14px 28px -6px rgba(15, 23, 42, 0.08), 0 6px 12px -4px rgba(15, 23, 42, 0.04);
            --shadow-glow: 0 10px 25px -5px rgba(79, 70, 229, 0.35);
        }

        body {
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: var(--color-bg-canvas);
            color: var(--color-text-body);
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            letter-spacing: -0.01em;
        }

        /* Glassmorphism Sticky Navbar */
        .navbar-custom {
            background: rgba(255, 255, 255, 0.94);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(226, 232, 240, 0.85);
            transition: all 0.25s ease;
            box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
            padding: 0.75rem 0;
        }

        .navbar-brand {
            font-weight: 800;
            color: var(--color-text-heading) !important;
            font-size: 1.35rem;
            letter-spacing: -0.03em;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
        }

        .brand-icon-box {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            background: linear-gradient(135deg, #4F46E5 0%, #7C3AED 100%);
            color: #ffffff;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
            box-shadow: 0 4px 10px rgba(79, 70, 229, 0.3);
        }

        .nav-link {
            font-weight: 600;
            font-size: 0.925rem;
            color: var(--color-text-muted) !important;
            padding: 0.5rem 0.95rem !important;
            border-radius: var(--radius-sm);
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .nav-link:hover {
            color: var(--color-primary) !important;
            background-color: var(--color-primary-light);
            transform: translateY(-1px);
        }

        .nav-link.active {
            color: var(--color-primary) !important;
            background-color: var(--color-primary-light);
            font-weight: 700;
        }

        /* Buttons */
        .btn-konekto {
            background: linear-gradient(135deg, #4F46E5 0%, #4338CA 100%);
            color: #ffffff !important;
            font-weight: 600;
            font-size: 0.885rem;
            border-radius: 10px;
            padding: 8px 18px;
            border: 1px solid rgba(255, 255, 255, 0.15);
            box-shadow: 0 2px 6px rgba(79, 70, 229, 0.25);
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        .btn-konekto:hover {
            background: linear-gradient(135deg, #4338CA 0%, #3730A3 100%);
            box-shadow: var(--shadow-glow);
            transform: translateY(-2px);
            color: #ffffff !important;
        }

        .btn-outline-konekto {
            background-color: transparent;
            color: var(--color-primary) !important;
            border: 1.5px solid var(--color-primary);
            font-weight: 600;
            font-size: 0.885rem;
            border-radius: 10px;
            padding: 7px 16px;
            transition: all 0.2s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        .btn-outline-konekto:hover {
            background-color: var(--color-primary-light);
            border-color: var(--color-primary-hover);
            color: var(--color-primary-hover) !important;
            transform: translateY(-1px);
        }

        /* Generic Cards */
        .card-custom {
            background: var(--color-bg-surface);
            border: 1px solid var(--color-border-subtle);
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-card);
            transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .card-custom:hover {
            border-color: var(--color-border-hover);
            box-shadow: var(--shadow-elevated);
            transform: translateY(-3px);
        }

        /* Subtle Badges */
        .badge-subtle-primary {
            background-color: #EEF2FF;
            color: #4F46E5;
            font-weight: 600;
            border-radius: var(--radius-full);
            padding: 5px 12px;
            font-size: 0.775rem;
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }

        .badge-subtle-success {
            background-color: #ECFDF5;
            color: #059669;
            font-weight: 600;
            border-radius: var(--radius-full);
            padding: 5px 12px;
            font-size: 0.775rem;
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }

        .badge-subtle-warning {
            background-color: #FFFBEB;
            color: #D97706;
            font-weight: 600;
            border-radius: var(--radius-full);
            padding: 5px 12px;
            font-size: 0.775rem;
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }

        .badge-subtle-info {
            background-color: #F0F9FF;
            color: #0284C7;
            font-weight: 600;
            border-radius: var(--radius-full);
            padding: 5px 12px;
            font-size: 0.775rem;
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }

        /* Pulse Dot for System Status */
        .pulse-dot {
            width: 8px;
            height: 8px;
            background-color: #10B981;
            border-radius: 50%;
            display: inline-block;
            box-shadow: 0 0 0 rgba(16, 185, 129, 0.4);
            animation: pulse-ring 2s infinite;
        }

        @@keyframes pulse-ring {
            0% {
                box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
            }
            70% {
                box-shadow: 0 0 0 8px rgba(16, 185, 129, 0);
            }
            100% {
                box-shadow: 0 0 0 0 rgba(16, 185, 129, 0);
            }
        }

        /* Modern Footer */
        .footer {
            margin-top: auto;
            background: #FFFFFF;
            border-top: 1px solid var(--color-border-subtle);
            color: var(--color-text-muted);
            font-size: 0.885rem;
        }

        .footer a {
            color: var(--color-text-muted);
            text-decoration: none;
            transition: color 0.2s ease;
        }

        .footer a:hover {
            color: var(--color-primary);
        }
    </style>
</head>
<body>
    <!-- Top Sticky Header -->
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-custom">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <span class="brand-icon-box">
                        <i class="fa-solid fa-graduation-cap"></i>
                    </span>
                    <span>Konekto</span>
                    <span class="badge bg-primary-subtle text-primary fw-bold ms-1" style="font-size: 0.68rem; border-radius: 6px; padding: 2px 7px;">v2.0</span>
                </a>

                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent" aria-expanded="false" aria-label="Menüyü Aç">
                    <i class="fa-solid fa-bars text-dark fs-5"></i>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3 gap-lg-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                <i class="fa-solid fa-house-chimney text-muted"></i> Ana Sayfa
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Announcements" asp-action="Index">
                                <i class="fa-solid fa-bullhorn text-muted"></i> Duyurular
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Alumni" asp-action="Index">
                                <i class="fa-solid fa-users text-muted"></i> Mezun Rehberi
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="About">
                                <i class="fa-solid fa-circle-nodes text-muted"></i> Ekosistem
                            </a>
                        </li>
                        @if (User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-danger fw-bold" asp-controller="Admin" asp-action="Index">
                                    <i class="fa-solid fa-shield-halved text-danger"></i> Yönetici Paneli
                                </a>
                            </li>
                        }
                    </ul>

                    <div class="d-flex align-items-center gap-2 pt-2 pt-lg-0">
                        <a href="/swagger" target="_blank" class="btn btn-sm btn-outline-secondary px-3 py-2 rounded-pill fw-semibold d-none d-md-inline-flex" title="Swagger REST API Dokümantasyonu">
                            <i class="fa-solid fa-code text-primary me-1"></i> Swagger API
                        </a>

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            var userRole = User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value ?? "User";
                            var roleBadgeClass = userRole switch
                            {
                                "Admin" => "bg-danger text-white",
                                "Student" => "bg-success-subtle text-success",
                                _ => "bg-primary-subtle text-primary"
                            };

                            <a asp-controller="Announcements" asp-action="Create" class="btn btn-sm btn-konekto rounded-pill px-3 py-2">
                                <i class="fa-solid fa-plus me-1"></i> Duyuru Yayınla
                            </a>

                            <div class="dropdown">
                                <button class="btn btn-sm btn-light border dropdown-toggle rounded-pill px-3 py-2 d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fa-solid fa-circle-user text-primary fs-6"></i>
                                    <span class="fw-bold text-dark small">@User.Identity.Name</span>
                                    <span class="badge @roleBadgeClass small ms-1" style="font-size: 0.7rem;">@userRole</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm border rounded-3 p-2">
                                    <li>
                                        <a class="dropdown-item rounded-2 py-2 small" asp-controller="Account" asp-action="Profile">
                                            <i class="fa-regular fa-id-badge text-primary me-2"></i> Profilim
                                        </a>
                                    </li>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li>
                                            <a class="dropdown-item rounded-2 py-2 small fw-bold text-danger" asp-controller="Admin" asp-action="Index">
                                                <i class="fa-solid fa-shield-halved me-2"></i> Yönetici Paneli
                                            </a>
                                        </li>
                                    }
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item rounded-2 py-2 small text-danger" asp-controller="Account" asp-action="Logout">
                                            <i class="fa-solid fa-right-from-bracket me-2"></i> Çıkış Yap
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="btn btn-sm btn-outline-konekto rounded-pill px-3 py-2">
                                <i class="fa-solid fa-right-to-bracket me-1"></i> Giriş Yap
                            </a>
                            <a asp-controller="Account" asp-action="Register" class="btn btn-sm btn-konekto rounded-pill px-3 py-2">
                                <i class="fa-solid fa-user-plus me-1"></i> Kayıt Ol
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Content Area -->
    <main class="py-4 flex-grow-1">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <!-- Rich Modern Footer -->
    <footer class="footer pt-5 pb-4">
        <div class="container">
            <div class="row g-4 pb-4 border-bottom">
                <!-- Col 1: Brand Info -->
                <div class="col-lg-4 col-md-6">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="brand-icon-box" style="width: 32px; height: 32px; font-size: 0.9rem;">
                            <i class="fa-solid fa-graduation-cap"></i>
                        </span>
                        <span class="fw-bold text-dark fs-5">Konekto</span>
                    </div>
                    <p class="text-muted small mb-3 leading-relaxed">
                        Üniversite mezunları ile öğrencileri ve akademik birimleri aynı çatı altında birleştiren yeni nesil profesyonel iletişim ve kariyer ekosistemi.
                    </p>
                    <div class="d-inline-flex align-items-center gap-2 px-3 py-1 bg-light rounded-pill border">
                        <span class="pulse-dot"></span>
                        <span class="text-secondary small fw-semibold" style="font-size: 0.78rem;">Tüm Sistemler Aktif • .NET 9.0</span>
                    </div>
                </div>

                <!-- Col 2: Navigation Links -->
                <div class="col-lg-2 col-md-3 col-6">
                    <h6 class="fw-bold text-dark mb-3">Keşfet</h6>
                    <ul class="list-unstyled small mb-0 d-flex flex-column gap-2">
                        <li><a asp-controller="Home" asp-action="Index">Ana Sayfa</a></li>
                        <li><a asp-controller="Announcements" asp-action="Index">Tüm Duyurular</a></li>
                        <li><a asp-controller="Alumni" asp-action="Index">Mezun Rehberi</a></li>
                        <li><a asp-controller="Home" asp-action="About">Hakkında</a></li>
                    </ul>
                </div>

                <!-- Col 3: Developer & API -->
                <div class="col-lg-3 col-md-3 col-6">
                    <h6 class="fw-bold text-dark mb-3">Geliştirici & API</h6>
                    <ul class="list-unstyled small mb-0 d-flex flex-column gap-2">
                        <li><a href="/swagger" target="_blank"><i class="fa-solid fa-arrow-up-right-from-square me-1"></i> Swagger UI</a></li>
                        <li><a href="/api/announcements" target="_blank">Minimal API Endpoints</a></li>
                        <li><a href="/api/users" target="_blank">User & Job API</a></li>
                        <li><a href="https://github.com" target="_blank"><i class="fa-brands fa-github me-1"></i> GitHub Repo</a></li>
                    </ul>
                </div>

                <!-- Col 4: Tech Stack Badge Grid -->
                <div class="col-lg-3 col-md-12">
                    <h6 class="fw-bold text-dark mb-3">Mimari Altyapı</h6>
                    <p class="text-muted small mb-3">Kurumsal ölçekli Clean Architecture ve modern bulut uyumlu standartlar.</p>
                    <div class="d-flex flex-wrap gap-1">
                        <span class="badge bg-light text-secondary border">C# 13</span>
                        <span class="badge bg-light text-secondary border">ASP.NET Core 9</span>
                        <span class="badge bg-light text-secondary border">EF Core 9</span>
                        <span class="badge bg-light text-secondary border">SQL Server</span>
                        <span class="badge bg-light text-secondary border">Docker Ready</span>
                    </div>
                </div>
            </div>

            <!-- Footer Bottom Strip -->
            <div class="d-flex flex-wrap justify-content-between align-items-center pt-4 small">
                <p class="text-muted mb-0">
                    © 2026 <strong>Konekto</strong>. Üniversite & Mezun Bilgi Sistemi. Tüm hakları saklıdır.
                </p>
                <div class="d-flex gap-3 text-muted">
                    <span>Gizlilik Politikası</span>
                    <span>•</span>
                    <span>Kullanım Koşulları</span>
                    <span>•</span>
                    <span>Erişilebilirlik</span>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5.3 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
