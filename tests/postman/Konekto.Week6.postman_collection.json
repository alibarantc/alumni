{
  "info": {
    "name": "Konekto – Week 6 API & Guardians smoke tests",
    "description": "Run after applying EF migrations and seeding SQL Server. Set validCompanyId and userId to real IDs. The /api/test-500 endpoint is Development-only.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"healthy\", () => pm.expect(pm.response.json().status).to.eql(\"Healthy\"));"
            ]
          }
        }
      ]
    },
